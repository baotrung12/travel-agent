# Database
DATABASE_URL=

# Supabase (image storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BASE_URL=

# Admin login
ADMIN_EMAIL=
ADMIN_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=

# Contact form notifications (email). Leave empty to only save requests in the admin.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail, SMTP_PASS=an App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Staff inbox(es) that receive new contact requests, comma-separated
CONTACT_EMAIL_TO=
